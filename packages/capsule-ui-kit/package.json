  "peerDependencies": {
    "vue": "3.5.43",
    "dockview-vue": "8.4.1",
    "dockview-core": "8.4.1",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "openvue": "1.0.0",
    "@openvue/themes": "1.0.0",
    "@openvue/icons": "1.0.0"
  },
  "files": [
    "index.js",
    "src",
    "types",
    "books",
    "tools"
  ],
  "engines": {
    "node": ">=24"
  }
}
