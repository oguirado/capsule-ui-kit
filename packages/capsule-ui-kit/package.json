{
  "name": "capsule-ui-kit",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./index.js",
    "./projection": "./src/state/publicProjection.js",
    "./layout": "./src/workspace/layoutProfile.js",
    "./registry": "./src/agent/controlRegistry.js",
    "./scheduler": "./src/surfaces/presentationScheduler.js",
    "./tokens": "./src/design/tokens.json",
    "./token-mappings": "./src/design/tokenMappings.json",
    "./DockWorkspace": {
      "types": "./types/DockWorkspace.d.ts",
      "default": "./src/workspace/DockWorkspace.vue"
    },
    "./CapsulePanel": {
      "types": "./types/CapsulePanel.d.ts",
      "default": "./src/capsules/CapsulePanel.vue"
    },
    "./MultiSlot": {
      "types": "./types/MultiSlot.d.ts",
      "default": "./src/capsules/MultiSlot.vue"
    },
    "./TerminalView": {
